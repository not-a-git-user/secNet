# Kafka bootstrap address. Keep the broker on the EC2 private network.
KAFKA_BOOTSTRAP_SERVERS=<EC2_KAFKA_PRIVATE_HOST>:9092
# Use PLAINTEXT only for a private development broker. Prefer SASL_SSL or SSL in production.
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# KAFKA_SASL_USERNAME=<username>
# KAFKA_SASL_PASSWORD=<password>
# KAFKA_SSL_CA_LOCATION=/etc/ssl/certs/kafka-ca.pem

# Required for stateless browser sessions. Generate with: openssl rand -hex 32
CHAT_SESSION_SECRET=<replace-with-a-long-random-secret>

# ---- File storage backend ------------------------------------------------ #
# Choose one: s3 | azure | gcp (stub) | r2 (stub)
FILE_STORE_BACKEND=s3

# AWS S3 (used when FILE_STORE_BACKEND=s3)
AWS_ACCESS_KEY_ID=<your-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-secret-access-key>
AWS_REGION=eu-north-1
S3_BUCKET_NAME=<your-s3-bucket-name>

# Azure Blob Storage (used when FILE_STORE_BACKEND=azure)
AZURE_STORAGE_CONNECTION_STRING=<your-connection-string>
AZURE_CONTAINER_NAME=<your-container-name>

# GCP Cloud Storage — NOT YET IMPLEMENTED (stub raises NotImplementedError)
# FILE_STORE_BACKEND=gcp
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GCP_BUCKET_NAME=<your-gcp-bucket-name>

# Cloudflare R2 — NOT YET IMPLEMENTED (stub raises NotImplementedError)
# FILE_STORE_BACKEND=r2
# R2_ACCOUNT_ID=<your-cloudflare-account-id>
# R2_ACCESS_KEY_ID=<your-r2-access-key>
# R2_SECRET_ACCESS_KEY=<your-r2-secret-key>
# R2_BUCKET_NAME=<your-r2-bucket-name>
